
events {}

http {
    upstream nextjs {
        server nextjs:3000;
    }

    server {
        listen 80;
        server_name nitish.site;

        return 301 https://$host$request_uri;
    }

    # HTTP server
    server {
        listen 80;
        server_name portfolio.nitish.site;

        # Keep this accessible for future renewals
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        # Redirect everything else to HTTPS
        location / {
            return 301 https://$host$request_uri;
        }
    }

    # HTTPS server
    server {
        listen 443 ssl;
        server_name portfolio.nitish.site;

        ssl_certificate /etc/letsencrypt/live/portfolio.nitish.site/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/portfolio.nitish.site/privkey.pem;

        ssl_protocols TLSv1.2 TLSv1.3;

        location / {
            proxy_pass http://nextjs;
            proxy_http_version 1.1;

            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;

            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
